# Supabase Configuration
# Get these values from your Supabase project settings
NG_APP_SUPABASE_URL=https://your-project.supabase.co
NG_APP_SUPABASE_ANON_KEY=your-anon-key-here

# Beta Access Configuration
# Set to 'true' to require beta access code, 'false' to disable
NG_APP_REQUIRES_BETA_ACCESS=true
# Hash of the beta access code (if beta access is enabled)
NG_APP_BETA_ACCESS_CODE_HASH=your-beta-code-hash-here

# Note: The script also accepts shorter variable names without NG_APP_ prefix
# (SUPABASE_URL, SUPABASE_ANON_KEY, etc.) for backward compatibility

