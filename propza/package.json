{
  "name": "propza",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:dev && npm run serve:dev",
    "serve": "npm run build:dev && npm run serve:dev",
    "build": "ts-node scripts/generate-env.ts && ng build",
    "build:dev": "ts-node scripts/generate-env.ts && ng build --configuration development",
    "build:vercel": "ts-node scripts/generate-env.ts && ng build --configuration production",
    "replace-env-vars": "node scripts/replace-env-vars.js",
    "replace-env-vars:dev": "node scripts/replace-env-vars.js dev",
    "serve:dev": "node scripts/dev-server.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prebuild": "ts-node scripts/generate-env.ts",
    "postbuild": "echo '\n🎉 Build complete! KFTY -' && date",
    "kill": "lsof -ti:4201 | xargs kill -9 2>/dev/null || echo 'No process running on port 4201'"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@angular/service-worker": "^18.2.0",
    "@ng-bootstrap/ng-bootstrap": "^17.0.1",
    "@popperjs/core": "^2.11.8",
    "@supabase/supabase-js": "^2.75.0",
    "bootstrap": "^5.3.2",
    "lottie-web": "^5.13.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.0",
    "@angular/localize": "^18.2.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^24.9.1",
    "chokidar": "^4.0.3",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "http-server": "^14.1.1",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.5.2"
  }
}
